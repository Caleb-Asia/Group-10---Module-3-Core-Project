            <form @submit.prevent="handleRegister">
              <!-- Name & Email -->
              <div class="row-grid mb-4">
                <div class="form-group">
                  <label class="auth-label">Full name</label>
                  <input 
                    type="text" 
                    v-model="form.name" 
