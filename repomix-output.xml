}

/* 6. Buttons */
[data-theme="dark"] .btn--outline {
  color: #F26A1B !important;
  border-color: #F26A1B !important;
}

[data-theme="dark"] .btn--outline:hover {
  background-color: #F26A1B !important;
  color: #FFFFFF !important;
}

[data-theme="dark"] .btn--ghost {
  color: #D1D5DB !important;
}

/* 7. Chips */
[data-theme="dark"] .chip--filter {
  background-color: #22304A !important;
  color: #E5E7EB !important;
  border-color: #2D3748 !important;
}

[data-theme="dark"] .chip--filter.active {
  background-color: #F26A1B !important;
  color: #FFFFFF !important;
  border-color: #F26A1B !important;
}

/* 8. Special Card backgrounds */
[data-theme="dark"] .referral-card {
  background-color: #F26A1B !important;
}

[data-theme="dark"] .referral-card h4,
[data-theme="dark"] .referral-card p,
[data-theme="dark"] .referral-card span {
  color: #FFFFFF !important;
}

/* 9. Toggle & Switches */
[data-theme="dark"] .switch {
  background-color: #2D3748 !important;
}

/* ============================================
   27. COMPONENT DARK MODE FIXES
   ============================================ */

/* 1. BIGGER DIETARY TAGS (Everywhere in Dark Mode) */
