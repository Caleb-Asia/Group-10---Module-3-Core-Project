}

[data-theme="dark"] p,
[data-theme="dark"] span,
[data-theme="dark"] div,
[data-theme="dark"] li,
[data-theme="dark"] label,
[data-theme="dark"] .text-muted,
[data-theme="dark"] .text-gray,
[data-theme="dark"] .auth-subtitle,
