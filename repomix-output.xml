  color: #FFFFFF;
  font-size: 14px;
  font-weight: 700;
  padding: 6px 12px;
  border-radius: 20px;
}

/* 2. NUTRITION BOXES (Dark Mode) */
[data-theme="dark"] .nutrition-box {
  background: #0B1120;
}

[data-theme="dark"] .nutrition-box strong {
  color: #FFFFFF;
}

[data-theme="dark"] .nutrition-box span {
  color: #9CA3AF;
}

/* 3. CHECKOUT PODS (Dark Mode) */
[data-theme="dark"] .pod-card {
  background: #1A2436;
  border: 2px solid #2D3748;
}

[data-theme="dark"] .pod-card:hover {
  border-color: var(--color-orange);
}

[data-theme="dark"] .pod-name {
