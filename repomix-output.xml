[data-theme="dark"] .cart-item-card,
[data-theme="dark"] .auth-form-side,
[data-theme="dark"] .detail-card,
[data-theme="dark"] .pod-card,
[data-theme="dark"] .subscription-card,
[data-theme="dark"] .dashboard-card,
[data-theme="dark"] .action-grid,
[data-theme="dark"] .box-option {
  background-color: #1A2436 !important;
  border-color: #2D3748 !important;
}

/* 3. All Text - Force White/Grey */
[data-theme="dark"] h1,
[data-theme="dark"] h2,
[data-theme="dark"] h3,
[data-theme="dark"] h4,
[data-theme="dark"] h5,
[data-theme="dark"] h6,
